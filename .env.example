# ----------------------------------------------------------------------------
# Copy this file to ".env" and fill in your keys. Never commit your real .env.
# ----------------------------------------------------------------------------

# fal.ai API key  ->  https://fal.ai/dashboard/keys
FAL_KEY=

# Anthropic (Claude) API key, used to auto-split your story into scenes
# ->  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which image model to use. Options:
#   seedream  -> fal-ai/bytedance/seedream/v4/edit   (DEFAULT; no SynthID watermark)
#   nano      -> fal-ai/nano-banana/edit             (Gemini 2.5 Flash; adds SynthID)
#   nano-pro  -> fal-ai/nano-banana-pro/edit         (highest quality; pricier + SynthID)
IMAGE_MODEL=seedream

# Claude model used for scene splitting
SCENE_MODEL=claude-sonnet-4-6

# Default output aspect ratio for slides (TikTok is vertical 9:16)
ASPECT_RATIO=9:16

# Your site, used for the casual CTA at the start of every post caption.
SITE_URL=nordiva.ai

# The product the stories quietly build toward (the SMV comparison software).
PRODUCT_NAME=Nordiva
PRODUCT_PITCH=a tool that compares two people's dating-market value (SMV) side by side

# ----------------------------------------------------------------------------
# Fixed lead character (the SAME woman in every video). Put her reference photos
# in assets/protagonist/ (committed). Tune the description to match her.
# ----------------------------------------------------------------------------
LEAD_NAME=Jen
LEAD_DESCRIPTION=woman in her early-to-mid 30s, long dark brown hair, fair skin, blue-green eyes, full lips, natural makeup, casual everyday outfits

# ----------------------------------------------------------------------------
# Grok (xAI) writes the stories for hands-off runs. Key: https://console.x.ai
# ----------------------------------------------------------------------------
XAI_API_KEY=
GROK_MODEL=grok-4

# Automation: which platforms each scheduled run posts to, and slides per story.
AUTO_PLATFORMS=tiktok,facebook,instagram
AUTO_NUM_SLIDES=7

# ----------------------------------------------------------------------------
# Posting to TikTok via Blotato (recommended — posts as DRAFTS, no TikTok app
# audit needed). Get your API key at https://my.blotato.com/settings/api and
# connect your TikTok account in Blotato first.
# ----------------------------------------------------------------------------
BLOTATO_API_KEY=
# Account ids per platform. Leave blank to auto-detect when exactly one account
# of that platform is connected in Blotato.
BLOTATO_TIKTOK_ACCOUNT_ID=
BLOTATO_FACEBOOK_ACCOUNT_ID=
BLOTATO_INSTAGRAM_ACCOUNT_ID=
# Facebook Page id to post reels to (numeric FB Page id, NOT the Blotato account
# id). Find it via GET /v2/users/me/accounts/{accountId}/subaccounts.
FACEBOOK_PAGE_ID=
# Instagram reels: also show on the profile feed grid.
INSTAGRAM_SHARE_TO_FEED=true
# Tell TikTok the post is AI-generated? false = don't (matches the unflagged goal).
TIKTOK_LABEL_AI=false

# Reel video (Instagram/Facebook): seconds each slide is shown, and the
# "Wait for it" hook burned on the first slide so it doesn't look frozen.
REEL_SECONDS_PER_SLIDE=3
REEL_WAIT_ENABLED=true
REEL_WAIT_TEXT=Wait for it

# ----------------------------------------------------------------------------
# Legacy: TikTok's own Content Posting API (optional, needs app audit). Not used
# when Blotato is configured. Create an app at
# https://developers.tiktok.com/  -> add "Content Posting API" + "Login Kit".
# Until your app passes TikTok's audit, posts go to your DRAFTS (unaudited
# apps can only post privately / to the inbox).
# ----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/tiktok/callback

# Server host/port
HOST=127.0.0.1
PORT=8000
